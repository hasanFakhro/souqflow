generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url  	    = env("DATABASE_URL")
  // uncomment next line if you use Prisma <5.10
}
enum Role {
  USER
  ADMIN
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  phone     String  @unique
  image     String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  subscription Subscription?

  @@map("users")
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String   @unique
  startDate DateTime @default(now())
  endDate   DateTime?
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscription")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  imageUrl    String?
  sku         String?  @unique
  category    String?

  costPrice   Float    
  sellPrice   Float    

  quantity    Int      @default(0)   
  lowStockAt  Int?     

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
 @@map("products")
}

model ExchangeRate {
  id        String   @id @default(cuid())
  usdToLbp  Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("exchange_rates")
}
