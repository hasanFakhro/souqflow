generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  name         String?
  email        String        @unique
  password     String
  image        String?
  role         Role          @default(USER)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  phone        String        @unique
  business     Business?
  categories   Category[]
  orders       Order[]
  products     Product[]
  subscription Subscription?
  notifications Notification[]

  @@map("users")
}

model Subscription {
  id        String    @id @default(cuid())
  userId    String    @unique
  startDate DateTime  @default(now())
  endDate   DateTime?
  isActive  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscription")
}

model Product {
  id          String      @id @default(cuid())
  name        String
  description String?
  imageUrl    String?
  sku         String?
  costPrice   Float
  sellPrice   Float
  quantity    Int         @default(0)
  lowStockAt  Int?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  categoryId  String?
  ownerId     String?
  orderItems  OrderItem[]
  category    Category?   @relation(fields: [categoryId], references: [id])
  users       User?       @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, sku])
  @@index([categoryId])
  @@index([ownerId, createdAt])
  @@map("products")
}

model Category {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  ownerId   String?
  users     User?     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  products  Product[]

  @@unique([ownerId, name])
  @@index([ownerId, name])
  @@map("categories")
}

model Order {
  id           String      @id @default(cuid())
  orderNumber  String      @unique
  customerName String?
  status       OrderStatus @default(PENDING)
  orderedAt    DateTime    @default(now())
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  total        Float       @default(0)
  ownerId      String?
  source       OrderSource @default(MANUAL)
  items        OrderItem[]
  users        User?       @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([orderedAt, status])
  @@index([ownerId, orderedAt])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String?
  productName String
  category    String?
  quantity    Int
  unitCost    Float
  unitPrice   Float
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([category])
  @@map("order_items")
}

model ExchangeRate {
  id        String   @id @default(cuid())
  usdToLbp  Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("exchange_rates")
}

model Business {
  id          String   @id @default(cuid())
  name        String
  logo        String?
  description String?
  instagram   String?
  facebook    String?
  tiktok      String?
  userId      String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

   
   user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("businesses")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  message   String
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId,isRead])
  @@map("notifications")
}





enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  DONE       @map("COMPLETED")
  PROBLEM    @map("CANCELED")
  DELIVERING
}

enum OrderSource {
  STOREFRONT
  MANUAL
}
