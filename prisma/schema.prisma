generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  DELIVERING
  DONE       @map("COMPLETED")
  PROBLEM    @map("CANCELED")
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  phone     String   @unique
  image     String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscription Subscription?
  products     Product[]     @relation("UserProducts")
  orders       Order[]       @relation("UserOrders")
  categories   Category[]    @relation("UserCategories")

  @@map("users")
}

model Subscription {
  id        String    @id @default(cuid())
  userId    String    @unique
  startDate DateTime  @default(now())
  endDate   DateTime?
  isActive  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscription")
}

model Product {
  id          String  @id @default(cuid())
  name        String
  description String?
  imageUrl    String?
  sku         String?

  // Nullable only for records that existed before ownership was introduced.
  // New products are always created with an ownerId by the API.
  ownerId String?
  owner   User?   @relation("UserProducts", fields: [ownerId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  costPrice  Float
  sellPrice  Float
  quantity   Int   @default(0)
  lowStockAt Int?

  orderItems OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([ownerId, sku])
  @@index([ownerId, createdAt])
  @@index([categoryId])
  @@map("products")
}

model Category {
  id   String @id @default(cuid())
  name String

  // Nullable only for records that existed before ownership was introduced.
  ownerId  String?
  owner    User?     @relation("UserCategories", fields: [ownerId], references: [id], onDelete: Cascade)
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, name])
  @@index([ownerId, name])
  @@map("categories")
}

model Order {
  id           String      @id @default(cuid())
  orderNumber  String      @unique
  customerName String?
  total        Float       @default(0)
  status       OrderStatus @default(PENDING)

  // Nullable only for records that existed before ownership was introduced.
  ownerId String?
  owner   User?   @relation("UserOrders", fields: [ownerId], references: [id], onDelete: Cascade)

  orderedAt DateTime    @default(now())
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  items     OrderItem[]

  @@index([ownerId, orderedAt])
  @@index([orderedAt, status])
  @@map("orders")
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  productName String
  category    String?
  unitCost    Float
  unitPrice   Float
  quantity    Int
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([category])
  @@map("order_items")
}

model ExchangeRate {
  id        String   @id @default(cuid())
  usdToLbp  Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("exchange_rates")
}
